<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext HTTP stays off, except to the in-app loopback playback proxy
     (lib/core/api/playback_proxy.dart): the video player streams from
     http://127.0.0.1:<port>/<token>/playback, and the proxy talks to the
     server over pinned TLS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
